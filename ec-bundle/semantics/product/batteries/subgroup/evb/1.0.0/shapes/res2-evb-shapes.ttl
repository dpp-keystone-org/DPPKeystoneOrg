# SPDX-License-Identifier: EUPL-1.2
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dpp: <https://repository.product-passport.ec.europa.eu/core/vocabs/core-vocabulary#> .
@prefix batevb-shapes: <https://repository.product-passport.ec.europa.eu/product/batteries/subgroup/evb/shapes/> .

batevb-shapes:battery-evb-restricted-2-shapes
    a sh:NodeShape ;
    sh:targetClass dpp:DigitalProductPassport ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path dpp:contentSpecificationIds ;
                    sh:hasValue "https://repository.product-passport.ec.europa.eu/product/batteries/subgroup/evb/1.0.0/res2"
                ]
            ]
        ]
        batevb-shapes:battery-evb-restricted-2-constraints
    ) ;
    sh:message "SEM-MSG-009" .

batevb-shapes:battery-evb-restricted-2-constraints
    a sh:NodeShape ;

    sh:property [
        sh:path dpp:contentSpecificationIds ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:hasValue "https://repository.product-passport.ec.europa.eu/product/batteries/1.0.0/res2" ;
        sh:message "SEM-MSG-009"
    ] .