# SPDX-License-Identifier: EUPL-1.2
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix batevb-shapes: <https://repository.product-passport.ec.europa.eu/product/batteries/subgroup/evb/shapes/> .
@prefix dpp: <https://repository.product-passport.ec.europa.eu/core/vocabs/core-vocabulary#> .
@prefix bat: <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#> .
@prefix batcat: <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-category#> .

batevb-shapes:battery-evb-public-shapes
    a sh:NodeShape ;
    sh:targetClass dpp:DigitalProductPassport ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path dpp:contentSpecificationIds ;
                    sh:hasValue "https://repository.product-passport.ec.europa.eu/product/batteries/subgroup/evb/1.0.0/pub"
                ]
            ]
        ]
        batevb-shapes:battery-evb-public-constraints
    ) ;
    sh:message "SEM-MSG-009" .

batevb-shapes:battery-evb-public-constraints
    a sh:NodeShape ;

    sh:property [
        sh:path dpp:contentSpecificationIds ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:hasValue "https://repository.product-passport.ec.europa.eu/product/batteries/1.0.0/pub" ;
        sh:message "SEM-MSG-009"
    ] ;

    sh:property [
        sh:path bat:batteryCategory ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in ( batcat:electricVehicleBattery ) ;
        sh:message "SEM-BAT-MSG-009"
    ] ;

    sh:property [
        sh:path bat:expectedLifetimeCycles ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:integer ]
            [ sh:datatype xsd:nonNegativeInteger ]
            [ sh:datatype xsd:positiveInteger ]
        ) ;
        sh:pattern "^-?[0-9]+$" ;
        sh:minInclusive 1 ;
        sh:message "SEM-BAT-MSG-031"
    ] ;

    sh:property [
        sh:path bat:cycleLifeReferenceTest ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:minLength 1 ;
        sh:message "SEM-BAT-MSG-032"
    ] ;

    sh:property [
        sh:path bat:cycleLifeReferenceTest ;
        sh:message "SEM-COM-MSG-012" ;
        sh:sparql [
            a sh:SPARQLConstraint ;
            sh:select """
                PREFIX bat: <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#>
                PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

                SELECT $this (?value AS ?path)
                WHERE {
                    $this bat:cycleLifeReferenceTest ?value .
                    BIND(lang(?value) AS ?langTag)
                    FILTER(!regex(?langTag, "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"))
                }
            """ ;
        ] ;
    ] ;

    sh:property [
        sh:path bat:capacityExhaustionThreshold ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:integer ]
        ) ;
        sh:message "SEM-BAT-MSG-033"
    ] ;

    sh:property [
        sh:path bat:initialRoundTripEnergyEfficiency ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:integer ]
        ) ;
        sh:message "SEM-BAT-MSG-037"
    ] ;

    sh:property [
        sh:path bat:roundTripEfficiencyAtHalfCycleLife ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:integer ]
        ) ;
        sh:message "SEM-BAT-MSG-038"
    ] ;

    sh:property [
        sh:path bat:cycleLifeChargeCRate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:integer ]
        ) ;
        sh:message "SEM-BAT-MSG-041"
    ] .