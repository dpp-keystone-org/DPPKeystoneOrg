# SPDX-License-Identifier: EUPL-1.2
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dpp: <https://repository.product-passport.ec.europa.eu/core/vocabs/core-vocabulary#> .
@prefix batevb-shapes: <https://repository.product-passport.ec.europa.eu/product/batteries/subgroup/evb/shapes/> .
@prefix bat: <https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-vocabulary#> .

batevb-shapes:battery-evb-restricted-3-shapes
    a sh:NodeShape ;
    sh:targetClass dpp:DigitalProductPassport ;
    sh:or (
        [
            sh:not [
                sh:property [
                    sh:path dpp:contentSpecificationIds ;
                    sh:hasValue "https://repository.product-passport.ec.europa.eu/product/batteries/subgroup/evb/1.0.0/res3"
                ]
            ]
        ]
        batevb-shapes:battery-evb-restricted-3-constraints
    ) ;
    sh:message "SEM-MSG-009" .

batevb-shapes:battery-evb-restricted-3-constraints
    a sh:NodeShape ;

    sh:property [
        sh:path dpp:contentSpecificationIds ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:hasValue "https://repository.product-passport.ec.europa.eu/product/batteries/1.0.0/res3" ;
        sh:message "SEM-MSG-009"
    ] ;

    sh:property [
        sh:path bat:expectedLifetimeCyclesRest ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:integer ]
            [ sh:datatype xsd:nonNegativeInteger ]
            [ sh:datatype xsd:positiveInteger ]
        ) ;
        sh:pattern "^-?[0-9]+$" ;
        sh:minInclusive 0 ;
        sh:message "SEM-BAT-MSG-072"
    ] ;

    sh:property [
        sh:path bat:expectedLifetimeYears ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:integer ]
            [ sh:datatype xsd:nonNegativeInteger ]
            [ sh:datatype xsd:positiveInteger ]
        ) ;
        sh:pattern "^-?[0-9]+$" ;
        sh:minInclusive 1 ;
        sh:message "SEM-BAT-MSG-073"
    ] ;

    sh:property [
        sh:path bat:ratedCapacity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:integer ]
        ) ;
        sh:message "SEM-BAT-MSG-064"
    ] ;

    sh:property [
        sh:path bat:capacityFade ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:integer ]
        ) ;
        sh:message "SEM-BAT-MSG-065"
    ] ;

    sh:property [
        sh:path bat:powerCapability ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:integer ]
        ) ;
        sh:message "SEM-BAT-MSG-066"
    ] ;

    sh:property [
        sh:path bat:powerFade ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:integer ]
        ) ;
        sh:message "SEM-BAT-MSG-067"
    ] ;

    sh:property [
        sh:path bat:internalResistance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:integer ]
        ) ;
        sh:message "SEM-BAT-MSG-068"
    ] ;

    sh:property [
        sh:path bat:internalResistanceIncrease ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:integer ]
        ) ;
        sh:message "SEM-BAT-MSG-069"
    ] ;

    sh:property [
        sh:path bat:stateOfCertifiedEnergy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:integer ]
        ) ;
        sh:message "SEM-BAT-MSG-074"
    ] ;

    sh:property [
        sh:path bat:remainingCapacity ;
        sh:maxCount 0 ;
        sh:message "SEM-BAT-MSG-075"
    ] ;

    sh:property [
        sh:path bat:remainingPowerCapability ;
        sh:maxCount 0 ;
        sh:message "SEM-BAT-MSG-076"
    ] ;

    sh:property [
        sh:path bat:remainingRoundTripEfficiency ;
        sh:maxCount 0 ;
        sh:message "SEM-BAT-MSG-077"
    ] ;

    sh:property [
        sh:path bat:selfDischargingRateSet ;
        sh:maxCount 0 ;
        sh:message "SEM-BAT-MSG-078"
    ] ;

    sh:property [
        sh:path bat:ohmicResistance ;
        sh:maxCount 0 ;
        sh:message "SEM-BAT-MSG-081"
    ] .