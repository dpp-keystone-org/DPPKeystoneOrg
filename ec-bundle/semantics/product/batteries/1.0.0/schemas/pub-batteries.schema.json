{
  "$id": "https://repository.product-passport.ec.europa.eu/product/batteries/1.0.0/schemas/pub-batteries.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Battery Product - Public view",
  "description": "JSON Schema for the public properties of the Battery Product representation.",
  "type": "object",
  "if": {
    "type": "object",
    "properties": {
      "contentSpecificationIds": {
        "type": "array",
        "contains": {
          "const": "https://repository.product-passport.ec.europa.eu/product/batteries/1.0.0/pub"
        }
      }
    },
    "required": [
      "contentSpecificationIds"
    ]
  },
  "then": {
    "type": "object",
    "properties": {
    "registrantIdentity": {
      "type": "string",
      "minLength": 1,
      "$comment": "Validation error code: SEM-BAT-MSG-089"
    },
    "manufacturerIdentification": {
      "type": "object",
      "properties": {
        "manufacturerName": {
          "type": "string",
          "minLength": 1,
          "$comment": "Validation error code: SEM-BAT-MSG-002"
        },
        "manufacturerTradeName": {
          "type": "string",
          "minLength": 1,
          "$comment": "Validation error code: SEM-BAT-MSG-003"
        },
        "manufacturerTrademark": {
          "type": "string",
          "minLength": 1,
          "$comment": "Validation error code: SEM-BAT-MSG-004"
        }
      },
      "anyOf": [
        {
          "properties": {
            "manufacturerName": true
          },
          "required": [
            "manufacturerName"
          ]
        },
        {
          "properties": {
            "manufacturerTradeName": true
          },
          "required": [
            "manufacturerTradeName"
          ]
        },
        {
          "properties": {
            "manufacturerTrademark": true
          },
          "required": [
            "manufacturerTrademark"
          ]
        }
      ],
      "$comment": "Validation error code: SEM-BAT-MSG-001"
    },
    "manufacturerPostalAddress": {
      "type": "string",
      "minLength": 1,
      "$comment": "Validation error code: SEM-BAT-MSG-005"
    },
    "manufacturerContactDetails": {
      "type": "object",
      "properties": {
        "manufacturerWebsite": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "$comment": "Validation error code: SEM-BAT-MSG-007"
        },
        "manufacturerEmail": {
          "type": "string",
          "format": "email",
          "minLength": 1,
          "$comment": "Validation error code: SEM-BAT-MSG-008"
        }
      },
      "anyOf": [
        {
          "properties": {
            "manufacturerWebsite": true
          },
          "required": [
            "manufacturerWebsite"
          ]
        },
        {
          "properties": {
            "manufacturerEmail": true
          },
          "required": [
            "manufacturerEmail"
          ]
        }
      ],
      "$comment": "Validation error code: SEM-BAT-MSG-006"
    },
    "batteryCategory": {
      "type": "string",
      "enum": [
        "electricVehicleBattery",
        "lightMeansOfTransportBattery",
        "industrialBattery"
      ],
      "$comment": "Controlled vocabulary: https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-category# | Validation error code: SEM-BAT-MSG-009"
    },
    "batteryIdentification": {
      "type": "object",
      "properties": {
        "modelIdentifier": {
          "type": "string",
          "minLength": 1,
          "$comment": "Validation error code: SEM-BAT-MSG-011"
        },
        "batchNumber": {
          "type": "string",
          "minLength": 1,
          "$comment": "Validation error code: SEM-BAT-MSG-012"
        },
        "serialNumber": {
          "type": "string",
          "minLength": 1,
          "$comment": "Validation error code: SEM-BAT-MSG-013"
        },
        "productNumber": {
          "type": "string",
          "minLength": 1,
          "$comment": "Validation error code: SEM-BAT-MSG-014"
        },
        "otherIdentificationElement": {
          "type": "string",
          "minLength": 1,
          "$comment": "Validation error code: SEM-BAT-MSG-015"
        }
      },
      "anyOf": [
        {
          "properties": {
            "modelIdentifier": true,
            "batchNumber": true
          },
          "required": [
            "modelIdentifier",
            "batchNumber"
          ]
        },
        {
          "properties": {
            "serialNumber": true
          },
          "required": [
            "serialNumber"
          ]
        },
        {
          "properties": {
            "productNumber": true
          },
          "required": [
            "productNumber"
          ]
        },
        {
          "properties": {
            "otherIdentificationElement": true
          },
          "required": [
            "otherIdentificationElement"
          ]
        }
      ],
      "dependentRequired": {
        "modelIdentifier": [
          "batchNumber"
        ],
        "batchNumber": [
          "modelIdentifier"
        ]
      },
      "$comment": "Validation error code: SEM-BAT-MSG-010"
    },
    "manufacturingPlace": {
      "type": "object",
      "properties": {
        "manufacturingCity": {
          "type": "string",
          "minLength": 1,
          "$comment": "Validation error code: SEM-BAT-MSG-017"
        },
        "manufacturingRegion": {
          "type": "string",
          "minLength": 1,
          "$comment": "Validation error code: SEM-BAT-MSG-018"
        },
        "manufacturingCountry": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "minLength": 1,
          "$comment": "Validation error code: SEM-BAT-MSG-019"
        }
      },
      "required": [
        "manufacturingCountry"
      ],
      "anyOf": [
        {
          "properties": {
            "manufacturingCity": true
          },
          "required": [
            "manufacturingCity"
          ]
        },
        {
          "properties": {
            "manufacturingRegion": true
          },
          "required": [
            "manufacturingRegion"
          ]
        }
      ],
      "$comment": "Validation error code: SEM-BAT-MSG-016"
    },
    "manufacturingDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$",
      "minLength": 1,
      "$comment": "Validation error code: SEM-BAT-MSG-020"
    },
    "batteryWeight": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-021"
    },
    "batteryCapacity": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-022"
    },
    "batteryChemistry": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "leadAcid",
          "nickelCadmium",
          "nickelMetalHydride",
          "lithiumIonNMC",
          "lithiumIonLFP",
          "lithiumIonLMO",
          "lithiumIonLCO",
          "lithiumIonNCA",
          "lithiumMetal",
          "sodiumIon"
        ],
        "$comment": "Controlled vocabulary: https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-chemistry#"
      },
      "$comment": "Validation error code: SEM-BAT-MSG-023"
    },
    "hazardousSubstances": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "$comment": "Validation error code: SEM-BAT-MSG-024"
    },
    "extinguishingAgent": {
      "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/multiLanguage",
      "$comment": "Validation error code: SEM-BAT-MSG-025"
    },
    "criticalRawMaterials": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "antimony",
          "arsenic",
          "bauxiteAluminaAluminium",
          "baryte",
          "beryllium",
          "bismuth",
          "boron",
          "cobalt",
          "cokingCoal",
          "copper",
          "feldspar",
          "fluorspar",
          "gallium",
          "germanium",
          "hafnium",
          "helium",
          "heavyRareEarthElements",
          "lightRareEarthElements",
          "lithium",
          "magnesium",
          "manganese",
          "graphite",
          "nickelBatteryGrade",
          "niobium",
          "phosphateRock",
          "phosphorus",
          "platinumGroupMetals",
          "scandium",
          "siliconMetal",
          "strontium",
          "tantalum",
          "titaniumMetal",
          "tungsten",
          "vanadium"
        ],
        "$comment": "Controlled vocabulary: https://repository.product-passport.ec.europa.eu/core/vocabs/critical-raw-material#"
      },
      "$comment": "Validation error code: SEM-BAT-MSG-026"
    },
    "renewableContentShare": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-090"
    },
    "minimalVoltage": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-091"
    },
    "minimalVoltageMinTemp": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-092"
    },
    "minimalVoltageMaxTemp": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-093"
    },
    "nominalVoltage": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-027"
    },
    "nominalVoltageMinTemp": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-094"
    },
    "nominalVoltageMaxTemp": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-095"
    },
    "maximumVoltage": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-028"
    },
    "maximumVoltageMinTemp": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-096"
    },
    "maximumVoltageMaxTemp": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-097"
    },
    "originalPowerCapability": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-029"
    },
    "powerLimit": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-030"
    },
    "powerLimitMinTemp": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-098"
    },
    "powerLimitMaxTemp": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-099"
    },
    "notInUseTemperatureRange": {
      "type": "object",
      "properties": {
        "lowerBound": {
          "type": "number",
          "$comment": "Validation error code: SEM-COM-MSG-005"
        },
        "upperBound": {
          "type": "number",
          "$comment": "Validation error code: SEM-COM-MSG-006"
        },
        "notInUseTemperatureRangeTest": {
          "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/multiLanguage",
          "$comment": "Validation error code: SEM-BAT-MSG-035"
        }
      },
      "required": [
        "lowerBound",
        "upperBound",
        "notInUseTemperatureRangeTest"
      ],
      "$comment": "Validation error code: SEM-BAT-MSG-034"
    },
    "commercialWarrantyPeriod": {
      "type": "integer",
      "minimum": 0,
      "$comment": "Validation error code: SEM-BAT-MSG-036"
    },
    "internalCellResistance": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-039"
    },
    "internalPackResistance": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-040"
    },
    "cycleLifeDischargeCRate": {
      "type": "number",
      "$comment": "Validation error code: SEM-BAT-MSG-042"
    },
    "separateCollectionSymbol": {
      "type": "boolean",
      "const": true,
      "$comment": "Validation error code: SEM-BAT-MSG-043"
    },
    "chemicalSymbol": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "cadmiumSymbol",
          "leadSymbol",
          "noneSymbol"
        ],
        "$comment": "Controlled vocabulary: https://repository.product-passport.ec.europa.eu/product/batteries/vocabs/battery-chemical-symbol#"
      },
      "$comment": "Validation error code: SEM-BAT-MSG-044"
    },
    "euDeclarationOfConformity": {
      "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/relatedResourceOrArray",
      "$comment": "Validation error code: SEM-BAT-MSG-045"
    },
    "wasteBatteryPreventionManagementInfo": {
      "type": "object",
      "properties": {
        "endUserRoleInWastePrevention": {
          "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/multiLanguage",
          "$comment": "Validation error code: SEM-BAT-MSG-047"
        },
        "endUserRoleInSeparateCollection": {
          "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/multiLanguage",
          "$comment": "Validation error code: SEM-BAT-MSG-048"
        },
        "separateCollectionPoints": {
          "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/multiLanguage",
          "$comment": "Validation error code: SEM-BAT-MSG-049"
        },
        "takeBackCollectionPoints": {
          "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/multiLanguage",
          "$comment": "Validation error code: SEM-BAT-MSG-050"
        },
        "preparationForReuseFacilities": {
          "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/multiLanguage",
          "$comment": "Validation error code: SEM-BAT-MSG-052"
        },
        "preparationForRepurposingFacilities": {
          "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/multiLanguage",
          "$comment": "Validation error code: SEM-BAT-MSG-053"
        },
        "wasteBatteryTreatmentFacilities": {
          "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/multiLanguage",
          "$comment": "Validation error code: SEM-BAT-MSG-054"
        },
        "wasteBatterySafetyInstructions": {
          "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/multiLanguage",
          "$comment": "Validation error code: SEM-BAT-MSG-055"
        },
        "batteryLabelSymbolMeaning": {
          "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/multiLanguage",
          "$comment": "Validation error code: SEM-BAT-MSG-057"
        },
        "batterySubstancesImpact": {
          "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/multiLanguage",
          "$comment": "Validation error code: SEM-BAT-MSG-058"
        }
      },
      "required": [
        "endUserRoleInWastePrevention",
        "endUserRoleInSeparateCollection",
        "separateCollectionPoints",
        "takeBackCollectionPoints",
        "preparationForReuseFacilities",
        "preparationForRepurposingFacilities",
        "wasteBatteryTreatmentFacilities",
        "wasteBatterySafetyInstructions",
        "batteryLabelSymbolMeaning",
        "batterySubstancesImpact"
      ],
      "$comment": "Validation error code: SEM-BAT-MSG-046"
    }
  },
  "dependentRequired": {
    "minimalVoltageMinTemp": [
      "minimalVoltageMaxTemp"
    ],
    "minimalVoltageMaxTemp": [
      "minimalVoltageMinTemp"
    ],
    "nominalVoltageMinTemp": [
      "nominalVoltageMaxTemp"
    ],
    "nominalVoltageMaxTemp": [
      "nominalVoltageMinTemp"
    ],
    "maximumVoltageMinTemp": [
      "maximumVoltageMaxTemp"
    ],
    "maximumVoltageMaxTemp": [
      "maximumVoltageMinTemp"
    ],
    "powerLimitMinTemp": [
      "powerLimitMaxTemp"
    ],
    "powerLimitMaxTemp": [
      "powerLimitMinTemp"
    ]
  },
  "required": [
    "registrantIdentity",
    "manufacturerIdentification",
    "manufacturerPostalAddress",
    "batteryCategory",
    "batteryIdentification",
    "manufacturingPlace",
    "manufacturingDate",
    "batteryWeight",
    "batteryCapacity",
    "batteryChemistry",
    "extinguishingAgent",
    "renewableContentShare",
    "minimalVoltage",
    "nominalVoltage",
    "maximumVoltage",
    "originalPowerCapability",
    "powerLimit",
    "notInUseTemperatureRange",
    "internalCellResistance",
    "internalPackResistance",
    "separateCollectionSymbol",
    "euDeclarationOfConformity",
    "wasteBatteryPreventionManagementInfo"
  ]
  }
}
