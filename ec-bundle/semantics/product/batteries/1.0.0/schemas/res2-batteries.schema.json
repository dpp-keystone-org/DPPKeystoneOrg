{
  "$id": "https://repository.product-passport.ec.europa.eu/product/batteries/1.0.0/schemas/res2-batteries.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Battery Product - Restricted: Only to notified bodies, MS authorities and COM (RES2)",
  "description": "JSON Schema for the Restricted (RES2) properties of the Battery Product representation.",
  "type": "object",
  "if": {
    "type": "object",
    "properties": {
      "contentSpecificationIds": {
        "type": "array",
        "contains": {
          "const": "https://repository.product-passport.ec.europa.eu/product/batteries/1.0.0/res2"
        }
      }
    },
    "required": [
      "contentSpecificationIds"
    ]
  },
  "then": {
    "type": "object",
    "properties": {
      "complianceTestReportResults": {
        "$ref": "https://repository.product-passport.ec.europa.eu/core/1.0.0/schemas/common.schema.json#/$defs/relatedResourceOrArray",
        "$comment": "Validation error code: SEM-BAT-MSG-063"
      }
    },
    "required": [
      "complianceTestReportResults"
    ]
  }
}
