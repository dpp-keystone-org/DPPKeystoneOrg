  dct:created "2026-10-30"^^xsd:date;
  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  skos:definition "contentSpecificationIds must be a list of non-empty content specification identifier Strings. It is optional when @context is provided; otherwise at least 1 identifier must be supplied."@en .

dpperr:SEM-MSG-010 a skos:Concept;
  skos:notation "SEM-MSG-010";
  skos:prefLabel "SEM-MSG-010"@en;
