  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  skos:definition "economicOperatorId must be a String. It is an optional field and must not occur more than 1 time."@en .

dpperr:SEM-MSG-013 a skos:Concept;
  skos:notation "SEM-MSG-013";
