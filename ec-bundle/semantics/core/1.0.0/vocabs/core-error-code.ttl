  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  skos:definition "additionalProductIdentifiers must be a list of non-empty Strings. It is an optional field."@en .

dpperr:SEM-MSG-011 a skos:Concept;
  skos:notation "SEM-MSG-011";
  skos:prefLabel "SEM-MSG-011"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
