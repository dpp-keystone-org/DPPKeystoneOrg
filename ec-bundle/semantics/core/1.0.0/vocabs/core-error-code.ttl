  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  skos:definition "productName must be a multilingual String. It is an optional field and may contain one or more language entries."@en .

dpperr:SEM-MSG-015 a skos:Concept;
