  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  skos:definition "lastUpdate must be a dateTime and must occur at least 1 time and must not occur more than 1 time."@en .

dpperr:SEM-MSG-009 a skos:Concept;
  skos:notation "SEM-MSG-009";
  skos:prefLabel "SEM-MSG-009"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
