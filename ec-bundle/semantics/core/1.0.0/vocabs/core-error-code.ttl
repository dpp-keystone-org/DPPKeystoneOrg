  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  skos:definition "dppStatus must be a code of instance-status and must occur at least 1 time and must not occur more than 1 time."@en .

dpperr:SEM-MSG-006 a skos:Concept;
  skos:notation "SEM-MSG-006";
  skos:prefLabel "SEM-MSG-006"@en;
  skos:inScheme <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
