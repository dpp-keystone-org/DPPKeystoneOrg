  skos:topConceptOf <https://repository.product-passport.ec.europa.eu/core/vocabs/core-error-code>;
  skos:definition "uniqueProductIdentifier must be a String and must occur at least 1 time and must not occur more than 1 time."@en .

dpperr:SEM-MSG-003 a skos:Concept;
  skos:notation "SEM-MSG-003";
  skos:prefLabel "SEM-MSG-003"@en;
