  "dcterms:description": [
    { "@language": "en", "@value": "Ontology defining specialized performance characteristic properties for common cement according to prEN 197-1:2026 Clause 4.2 and Table ZA.1.1.1." },
    { "@language": "bg", "@value": "Онтология, дефинираща специализирани свойства за експлоатационни характеристики на обикновен цимент съгласно prEN 197-1:2026 точка 4.2 и таблица ZA.1.1.1." },
    { "@language": "cs", "@value": "Ontologie definující specializované vlastnosti funkčních charakteristik pro běžný cement podle prEN 197-1:2026 čl. 4.2 a tabulky ZA.1.1.1." },
    { "@language": "da", "@value": "Ontologi, der definerer specialiserede ydeevneegenskaber for almindelig cement i henhold til prEN 197-1:2026 punkt 4.2 og tabel ZA.1.1.1." },
    { "@language": "de", "@value": "Ontologie zur Definition spezialisierter Leistungsmerkmale für Normalzement gemäß prEN 197-1:2026 Abschnitt 4.2 und Tabelle ZA.1.1.1." },
    { "@language": "el", "@value": "Οντολογία που ορίζει εξειδικευμένες ιδιότητες χαρακτηριστικών απόδοσης για κοινό τσιμέντο σύμφωνα με το prEN 197-1:2026 παράγραφος 4.2 και Πίνακα ZA.1.1.1." },
    { "@language": "es", "@value": "Ontología que define propiedades especializadas de características de prestación para el cemento común según prEN 197-1:2026 cláusula 4.2 y tabla ZA.1.1.1." },
    { "@language": "et", "@value": "Ontoloogia, mis määratleb tavalise tsemendi spetsialiseeritud toimivusomadused vastavalt standardi prEN 197-1:2026 punktile 4.2 ja tabelile ZA.1.1.1." },
    { "@language": "fi", "@value": "Ontologia, joka määrittelee yleissementin erikoistuneet suoritustaso-ominaisuudet standardin prEN 197-1:2026 kohdan 4.2 ja taulukon ZA.1.1.1 mukaisesti." },
    { "@language": "fr", "@value": "Ontologie définissant les propriétés spécialisées des caractéristiques de performance du ciment courant selon prEN 197-1:2026 article 4.2 et tableau ZA.1.1.1." },
    { "@language": "ga", "@value": "Ointeolaíocht a shainíonn airíonna saintréithe feidhmíochta speisialaithe le haghaidh gnáth-stroighne de réir prEN 197-1:2026 Alt 4.2 agus Tábla ZA.1.1.1." },
    { "@language": "hr", "@value": "Ontologija koja definira specijalizirana svojstva učinkovitosti za obični cement prema prEN 197-1:2026 točki 4.2 i tablici ZA.1.1.1." },
    { "@language": "hu", "@value": "A közönséges cement speciális teljesítményjellemzőit meghatározó ontológia a prEN 197-1:2026 4.2. szakasza és a ZA.1.1.1. táblázat szerint." },
    { "@language": "it", "@value": "Ontologia che definisce proprietà specializzate delle caratteristiche di prestazione per il cemento comune secondo prEN 197-1:2026 punto 4.2 e tabella ZA.1.1.1." },
    { "@language": "lt", "@value": "Ontologija, apibrėžianti specializuotas įprastinio cemento eksploatacinių charakteristikų savybes pagal prEN 197-1:2026 4.2 punktą ir ZA.1.1.1 lentelę." },
    { "@language": "lv", "@value": "Ontoloģija, kas definē specializētus parastā cementa ekspluatācijas raksturlielumu rekvizītus saskaņā ar prEN 197-1:2026 4.2. punktu un ZA.1.1.1. tabulu." },
    { "@language": "mt", "@value": "Ontoloġija li tiddefinixxi proprjetajiet speċjalizzati tal-karatteristiċi tal-prestazzjoni għas-siment komuni skont prEN 197-1:2026 Klawżola 4.2 u Tabella ZA.1.1.1." },
    { "@language": "nl", "@value": "Ontologie die gespecialiseerde eigenschappen van prestatiekenmerken voor gewoon cement definieert volgens prEN 197-1:2026 paragraaf 4.2 en tabel ZA.1.1.1." },
    { "@language": "pl", "@value": "Ontologia definiująca wyspecjalizowane właściwości cech użytkowych cementu powszechnego użytku zgodnie z prEN 197-1:2026 rozdział 4.2 i tabelą ZA.1.1.1." },
    { "@language": "pt", "@value": "Ontologia que define propriedades especializadas de características de desempenho para o cimento comum de acordo com a prEN 197-1:2026 secção 4.2 e quadro ZA.1.1.1." },
    { "@language": "ro", "@value": "Ontologie care definește proprietăți specializate ale caracteristicilor de performanță pentru cimentul obișnuit conform prEN 197-1:2026 articolul 4.2 și tabelul ZA.1.1.1." },
    { "@language": "sk", "@value": "Ontológia definujúca špecializované vlastnosti parametrov pre bežný cement podľa prEN 197-1:2026 čl. 4.2 a tabuľky ZA.1.1.1." },
    { "@language": "sl", "@value": "Ontologija, ki opredeljuje specializirane lastnosti učinkovitosti za običajni cement v skladu s prEN 197-1:2026 točko 4.2 in preglednico ZA.1.1.1." },
    { "@language": "sv", "@value": "Ontologi som definierar specialiserade prestandaegenskaper för vanligt cement enligt prEN 197-1:2026 avsnitt 4.2 och tabell ZA.1.1.1." }
  ],
  "dcterms:conformsTo": "prEN 197-1:2026",
