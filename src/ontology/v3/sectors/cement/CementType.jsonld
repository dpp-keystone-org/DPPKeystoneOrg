  "dcterms:description": [
    { "@language": "en", "@value": "Ontology defining standardized common cement types and designations according to EN 197-1 Table 220." },
    { "@language": "bg", "@value": "Онтология, дефинираща стандартизирани видове и обозначения на обикновен цимент съгласно EN 197-1 Таблица 220." },
    { "@language": "cs", "@value": "Ontologie definující standardizované typy a označení běžného cementu podle EN 197-1 tabulka 220." },
    { "@language": "da", "@value": "Ontologi, der definerer standardiserede almindelige cementtyper og betegnelser i henhold til EN 197-1 tabel 220." },
    { "@language": "de", "@value": "Ontologie zur Definition standardisierter Normalzementarten und Bezeichnungen gemäß EN 197-1 Tabelle 220." },
    { "@language": "el", "@value": "Οντολογία που ορίζει τυποποιημένους τύπους και ονομασίες κοινού τσιμέντου σύμφωνα με το πρότυπο EN 197-1 Πίνακας 220." },
    { "@language": "es", "@value": "Ontología que define los tipos y designaciones normalizados de cemento común según EN 197-1 Tabla 220." },
    { "@language": "et", "@value": "Ontoloogia, mis määratleb tavalise tsemendi standarditud tüübid ja tähistused vastavalt standardi EN 197-1 tabelile 220." },
    { "@language": "fi", "@value": "Ontologia, joka määrittelee yleissementtityypit ja -merkinnät standardin EN 197-1 taulukon 220 mukaisesti." },
    { "@language": "fr", "@value": "Ontologie définissant les types et désignations normalisés de ciments courants selon l'EN 197-1 Tableau 220." },
    { "@language": "ga", "@value": "Ointeolaíocht a shainíonn cineálacha caighdeánaithe gnáth-stroighne de réir EN 197-1 Tábla 220." },
    { "@language": "hr", "@value": "Ontologija koja definira standardizirane vrste i oznake običnog cementa prema EN 197-1 tablica 220." },
    { "@language": "hu", "@value": "A közönséges cement szabványos típusait és jelöléseit meghatározó ontológia az EN 197-1 220. táblázat szerint." },
    { "@language": "it", "@value": "Ontologia che definisce i tipi e le designazioni standard di cemento comune secondo EN 197-1 Tabella 220." },
    { "@language": "lt", "@value": "Ontologija, apibrėžianti įprastinio cemento standartizuotus tipus ir žymėjimus pagal EN 197-1 220 lentelę." },
    { "@language": "lv", "@value": "Ontoloģija, kas definē parastā cementa standartizētos veidus un apzīmējumus saskaņā ar EN 197-1 220. tabulu." },
    { "@language": "mt", "@value": "Ontoloġija li tiddefinixxi tipi u deżinjazzjonijiet standard tas-siment komuni skont EN 197-1 Tabella 220." },
    { "@language": "nl", "@value": "Ontologie die gestandaardiseerde typen en aanduidingen van gewoon cement definieert volgens EN 197-1 Tabel 220." },
    { "@language": "pl", "@value": "Ontologia definiująca znormalizowane typy i oznaczenia cementu powszechnego użytku wg EN 197-1 Tabela 220." },
    { "@language": "pt", "@value": "Ontologia que define tipos e designações normalizados de cimento comum de acordo com EN 197-1 Tabela 220." },
    { "@language": "ro", "@value": "Ontologie care definește tipurile și denumirile standardizate de ciment uzual conform EN 197-1 Tabelul 220." },
    { "@language": "sk", "@value": "Ontológia definujúca štandardizované typy a označenia bežného cementu podľa EN 197-1 tabuľka 220." },
    { "@language": "sl", "@value": "Ontologija, ki opredeljuje standardizirane vrste in oznake običajnega cementa po EN 197-1 Tabela 220." },
    { "@language": "sv", "@value": "Ontologi som definierar standardiserade vanliga cementtyper och beteckningar enligt EN 197-1 Tabell 220." }
  ],
