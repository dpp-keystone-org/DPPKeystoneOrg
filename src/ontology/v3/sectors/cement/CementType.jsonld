      "rdfs:comment": [
        { "@language": "en", "@value": "An enumeration of standard common cement types (Designation Code 1) according to EN 197-1 Table 220." },
        { "@language": "bg", "@value": "Изброяване на стандартните типове обикновен цимент (Код за обозначение 1) съгласно EN 197-1 Таблица 220." },
        { "@language": "cs", "@value": "Výčet standardních typů běžného cementu (Označovací kód 1) podle EN 197-1 tabulka 220." },
        { "@language": "da", "@value": "En opregning af standardtyper for almindelig cement (Betegnelseskode 1) i henhold til EN 197-1 tabel 220." },
        { "@language": "de", "@value": "Eine Aufzählung von Standard-Normalzementarten (Bezeichnungscode 1) gemäß EN 197-1 Tabelle 220." },
        { "@language": "el", "@value": "Απαρίθμηση των τυπικών τύπων κοινού τσιμέντου (Κωδικός ονομασίας 1) σύμφωνα με το πρότυπο EN 197-1 Πίνακας 220." },
        { "@language": "es", "@value": "Una enumeración de los tipos normalizados de cemento común (Código de designación 1) según EN 197-1 Tabla 220." },
        { "@language": "et", "@value": "Tavalise tsemendi standardtüüpide loetelu (tähistuskood 1) vastavalt standardi EN 197-1 tabelile 220." },
        { "@language": "fi", "@value": "Luettelo yleissementin standardityypeistä (merkintäkoodi 1) standardin EN 197-1 taulukon 220 mukaisesti." },
        { "@language": "fr", "@value": "Une énumération des types normalisés de ciment courant (Code de désignation 1) selon l'EN 197-1 Tableau 220." },
        { "@language": "ga", "@value": "Áireamh ar chineálacha caighdeánacha gnáth-stroighne (Cód Dearaidh 1) de réir EN 197-1 Tábla 220." },
        { "@language": "hr", "@value": "Popis standardnih vrsta običnog cementa (Oznaka 1) prema EN 197-1 tablica 220." },
        { "@language": "hu", "@value": "A közönséges cement szabványos típusainak felsorolása (1. jelölési kód) az EN 197-1 220. táblázat szerint." },
        { "@language": "it", "@value": "Un'enumerazione dei tipi standard di cemento comune (Codice di designazione 1) secondo EN 197-1 Tabella 220." },
        { "@language": "lt", "@value": "Įprastinio cemento standartinių tipų išvardijimas (1 žymėjimo kodas) pagal EN 197-1 220 lentelę." },
        { "@language": "lv", "@value": "Parastā cementa standarta veidu uzskaitījums (apzīmējuma kods 1) saskaņā ar EN 197-1 220. tabulu." },
        { "@language": "mt", "@value": "Elenku ta' tipi standard tas-siment komuni (Kodiċi ta' Deżinjazzjoni 1) skont EN 197-1 Tabella 220." },
        { "@language": "nl", "@value": "Een opsomming van standaard typen gewoon cement (Aanduidingscode 1) volgens EN 197-1 Tabel 220." },
        { "@language": "pl", "@value": "Wyczerpujące wyliczenie standardowych typów cementu powszechnego użytku (Kod oznaczenia 1) wg EN 197-1 Tabela 220." },
        { "@language": "pt", "@value": "Uma enumeração dos tipos normalizados de cimento comum (Código de designação 1) de acordo com EN 197-1 Tabela 220." },
        { "@language": "ro", "@value": "O enumerare a tipurilor standard de ciment uzual (Cod de desemnare 1) conform EN 197-1 Tabelul 220." },
        { "@language": "sk", "@value": "Výpočet štandardných typov bežného cementu (Označovací kód 1) podľa EN 197-1 tabuľka 220." },
        { "@language": "sl", "@value": "Seznam standardnih vrst običajnega cementa (Oznaka 1) po EN 197-1 Tabela 220." },
        { "@language": "sv", "@value": "En uppräkning av standardtyper av vanligt cement (Beteckningskod 1) enligt EN 197-1 Tabell 220." }
