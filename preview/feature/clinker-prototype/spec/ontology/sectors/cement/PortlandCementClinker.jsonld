  "dcterms:description": [
    {
      "@language": "en",
      "@value": "Ontology defining specialized performance characteristic properties for Portland cement clinker (K) according to prEN 197-1:2026 Clause 4.3.1.1 and Table ZA.1.1.2."
    },
    {
      "@language": "bg",
      "@value": "Онтология, дефинираща специализирани свойства за експлоатационни характеристики на портландциментов клинкер (K) съгласно prEN 197-1:2026 точка 4.3.1.1 и таблица ZA.1.1.2."
    },
    {
      "@language": "cs",
      "@value": "Ontologie definující specializované vlastnosti funkčních charakteristik pro slínek pro portlandský cement (K) podle prEN 197-1:2026 čl. 4.3.1.1 a tabulky ZA.1.1.2."
    },
    {
      "@language": "da",
      "@value": "Ontologi, der definerer specialiserede ydeevneegenskaber for portlandcementklinker (K) i henhold til prEN 197-1:2026 punkt 4.3.1.1 og tabel ZA.1.1.2."
    },
    {
      "@language": "de",
      "@value": "Ontologie zur Definition spezialisierter Leistungsmerkmale für Portlandzementklinker (K) gemäß prEN 197-1:2026 Abschnitt 4.3.1.1 und Tabelle ZA.1.1.2."
    },
    {
      "@language": "el",
      "@value": "Οντολογία που ορίζει εξειδικευμένες ιδιότητες χαρακτηριστικών απόδοσης για κλίνκερ τσιμέντου Πόρτλαντ (K) σύμφωνα με το prEN 197-1:2026 παράγραφος 4.3.1.1 και Πίνακα ZA.1.1.2."
    },
    {
      "@language": "es",
      "@value": "Ontología que define propiedades especializadas de características de prestación para el clínker de cemento Portland (K) según prEN 197-1:2026 cláusula 4.3.1.1 y tabla ZA.1.1.2."
    },
    {
      "@language": "et",
      "@value": "Ontoloogia, mis määratleb portlandtsemendi klinkri (K) spetsialiseeritud toimivusomadused vastavalt standardi prEN 197-1:2026 punktile 4.3.1.1 ja tabelile ZA.1.1.2."
    },
    {
      "@language": "fi",
      "@value": "Ontologia, joka määrittelee portlandsementtiklinkkerin (K) erikoistuneet suoritustaso-ominaisuudet standardin prEN 197-1:2026 kohdan 4.3.1.1 ja taulukon ZA.1.1.2 mukaisesti."
    },
    {
      "@language": "fr",
      "@value": "Ontologie définissant les propriétés spécialisées des caractéristiques de performance du clinker Portland (K) selon prEN 197-1:2026 article 4.3.1.1 et tableau ZA.1.1.2."
    },
    {
      "@language": "ga",
      "@value": "Ointeolaíocht a shainíonn airíonna saintréithe feidhmíochta speisialaithe le haghaidh clincir stroighne Portland (K) de réir prEN 197-1:2026 Alt 4.3.1.1 agus Tábla ZA.1.1.2."
    },
    {
      "@language": "hr",
      "@value": "Ontologija koja definira specijalizirana svojstva učinkovitosti za portland cementni klinker (K) prema prEN 197-1:2026 točki 4.3.1.1 i tablici ZA.1.1.2."
    },
    {
      "@language": "hu",
      "@value": "A portlandcement klinker (K) speciális teljesítményjellemzőit meghatározó ontológia a prEN 197-1:2026 4.3.1.1. szakasza és a ZA.1.1.2. táblázat szerint."
    },
    {
      "@language": "it",
      "@value": "Ontologia che definisce proprietà specializzate delle caratteristiche di prestazione per il clinker di cemento Portland (K) secondo prEN 197-1:2026 punto 4.3.1.1 e tabella ZA.1.1.2."
    },
    {
      "@language": "lt",
      "@value": "Ontologija, apibrėžianti specializuotas portlandcemenčio klinkerio (K) eksploatacinių charakteristikų savybes pagal prEN 197-1:2026 4.3.1.1 punktą ir ZA.1.1.2 lentelę."
    },
    {
      "@language": "lv",
      "@value": "Ontoloģija, kas definē specializētus portlandcementa klinkera (K) ekspluatācijas raksturlielumu rekvizītus saskaņā ar prEN 197-1:2026 4.3.1.1. punktu un ZA.1.1.2. tabulu."
    },
    {
      "@language": "mt",
      "@value": "Ontoloġija li tiddefinixxi proprjetajiet speċjalizzati tal-karatteristiċi tal-prestazzjoni għall-klinker tas-siment Portland (K) skont prEN 197-1:2026 Klawżola 4.3.1.1 u Tabella ZA.1.1.2."
    },
    {
      "@language": "nl",
      "@value": "Ontologie die gespecialiseerde eigenschappen van prestatiekenmerken voor portlandcementklinker (K) definieert volgens prEN 197-1:2026 paragraaf 4.3.1.1 en tabel ZA.1.1.2."
    },
    {
      "@language": "pl",
      "@value": "Ontologia definiująca wyspecjalizowane właściwości cech użytkowych klinkieru portlandzkiego (K) zgodnie z prEN 197-1:2026 rozdział 4.3.1.1 i tabelą ZA.1.1.2."
    },
    {
      "@language": "pt",
      "@value": "Ontologia que define propriedades especializadas de características de desempenho para o clínquer de cimento Portland (K) de acordo com a prEN 197-1:2026 secção 4.3.1.1 e quadro ZA.1.1.2."
    },
    {
      "@language": "ro",
      "@value": "Ontologie care definește proprietăți specializate ale caracteristicilor de performanță pentru clincherul de ciment Portland (K) conform prEN 197-1:2026 articolul 4.3.1.1 și tabelul ZA.1.1.2."
    },
    {
      "@language": "sk",
      "@value": "Ontológia definujúca špecializované vlastnosti parametrov pre slínok pre portlandský cement (K) podľa prEN 197-1:2026 čl. 4.3.1.1 a tabuľky ZA.1.1.2."
    },
    {
      "@language": "sl",
      "@value": "Ontologija, ki opredeljuje specializirane lastnosti učinkovitosti za portlandski cementni klinker (K) v skladu s prEN 197-1:2026 točko 4.3.1.1 in preglednico ZA.1.1.2."
    },
    {
      "@language": "sv",
      "@value": "Ontologi som definierar specialiserade prestandaegenskaper för portlandcementklinker (K) enligt prEN 197-1:2026 avsnitt 4.3.1.1 och tabell ZA.1.1.2."
    }
  ],
